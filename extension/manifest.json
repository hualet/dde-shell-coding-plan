{
  "manifest_version": 3,
  "name": "DDE Coding Plan Quota Helper",
  "version": "0.2.0",
  "description": "Reads AI coding plan quota pages and reports to DDE Shell plugin via WebSocket",
  "permissions": [
    "offscreen",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://www.kimi.com/*",
    "https://bigmodel.cn/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html"
}
